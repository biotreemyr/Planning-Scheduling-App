DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bio_tree_scheduler_mvp?schema=public"
# Local persistence works only in next dev on localhost. Production remains Core-only.
SCHEDULER_PERSISTENCE="local"
# Optional local backup folder; defaults to .backups (excluded from Git).
# SCHEDULER_BACKUP_DIR="/path/to/secure/backups"
# next dev defaults to demo. Production defaults to core and rejects demo.
SCHEDULER_AUTH_MODE="core"
# Trusted full Core/Clerk sign-in URL supplied by the dashboard owner.
BIO_TREE_CORE_SIGN_IN_URL=""
