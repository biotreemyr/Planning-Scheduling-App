# ─── Local scheduling database (this app's own data) ───
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bio_tree_scheduler_mvp?schema=public"
# Local persistence works only in next dev on localhost. Production remains Core-only.
SCHEDULER_PERSISTENCE="local"
# Optional local backup folder; defaults to .backups (excluded from Git).
# SCHEDULER_BACKUP_DIR="/path/to/secure/backups"

# ─── Access mode ───
# next dev defaults to demo. Production defaults to core and rejects demo.
# Set to "core" to sign in through the Bio Tree Core dashboard.
SCHEDULER_AUTH_MODE="core"

# ─── Bio Tree Core identity (Clerk) ───
# Must be the SAME Clerk instance as Bio Tree Core, or Core's session cookie is
# not recognised here. Copy from bio-tree-dashboard/.env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Core's Clerk sign-in page. Unauthenticated visitors are redirected here.
BIO_TREE_CORE_SIGN_IN_URL="https://dashboard.biotreegroup.com.my/sign-in"

# Where this app is served. Used to build the return URL Core sends the user
# back to after sign-in. Taken from config, never from the request Host header.
SCHEDULER_APP_URL="https://scheduler.biotreegroup.com.my"

# ─── Bio Tree Core directory (read-only) ───
# Read-only connection to the Core database, for app access and permission keys.
# This app never writes to it; a read-only role is recommended.
BIO_TREE_CORE_DATABASE_URL=""
# The app_key this deployment enforces, as registered in Core's `apps` table.
BIO_TREE_CORE_APP_KEY="scheduler"
# How long a resolved identity is cached, in milliseconds. Deactivating someone
# in Core takes effect within this window. Set 0 to disable caching.
BIO_TREE_CORE_CACHE_TTL_MS="30000"

# Bio Tree Master Data (master-data/docs/CONSUMING.md), read-only. The order form offers this
# company's active finished goods (FG- codes). Leave empty to use the scheduler's own products.
MASTER_DATA_DATABASE_URL=""
# btp or btb.
MASTER_DATA_COMPANY="btp"
